{
  "manifest_version": 3,
  "name": "Learn Spotlight",
  "version": "0.6.2",
  "description": "Search course resources using your signed-in Waterloo LEARN session.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "minimum_chrome_version": "116",
  "host_permissions": [
    "https://learn.uwaterloo.ca/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://learn.uwaterloo.ca/*"
      ],
      "js": [
        "dist/shortcut.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://student.cs.uwaterloo.ca/*",
    "https://www.student.cs.uwaterloo.ca/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src 'none'; frame-src 'none'; media-src 'none'; connect-src 'self' https://learn.uwaterloo.ca https://student.cs.uwaterloo.ca https://www.student.cs.uwaterloo.ca"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Learn Spotlight"
  },
  "commands": {
    "toggle-spotlight": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open or close Learn Spotlight"
    }
  }
}
